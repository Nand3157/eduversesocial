# ── App ──────────────────────────────────────────────────────────────
# Public site URL used for auth redirects and Meta OAuth URIs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Facebook / Instagram Meta app (Facebook Login product) ───────────
META_APP_ID=
META_APP_SECRET=
# Current stable Graph API version (v26.0 released July 29, 2026).
META_GRAPH_VERSION=v26.0
# Must match the OAuth redirect URI configured in the Meta app dashboard.
META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback

# ── Threads app (separate Meta app with the Threads product) ─────────
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/meta/threads/callback

# ── Security ─────────────────────────────────────────────────────────
# 32+ random characters used to encrypt OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=
# Shared secret protecting the scheduler endpoint from unauthenticated calls.
SCHEDULER_SECRET=

# ── Supabase (authentication + database) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Service role key, used ONLY by the server-side scheduler worker (never the
# browser). Required for scheduled publishing to work.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI (existing features, unaffected by Meta integration) ───────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# ── Rate limiting (optional, recommended in production) ──────────────
# Shared Upstash Redis backend so limits hold across serverless instances.
# Without these, the per-instance in-memory fallback applies (dev only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
